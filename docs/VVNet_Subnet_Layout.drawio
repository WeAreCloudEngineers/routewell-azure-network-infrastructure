<mxfile host="app.diagrams.net" modified="2026-11-25T10:45:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="vnet-subnet-layout" name="VNet and Subnet Layout"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="760" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="ROUTEWELL – VNET &amp; SUBNET LAYOUT" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="80" y="25" width="940" height="45" as="geometry" /></mxCell><mxCell id="vnet" value="&lt;b&gt;Azure Virtual Network (VNet)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Address space: 10.10.0.0/16&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Private network boundary for the three-tier deployment&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#4472C4;strokeWidth=3;verticalAlign=top;spacingTop=18;fontSize=16;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="90" y="100" width="920" height="500" as="geometry" /></mxCell><mxCell id="web" value="&lt;b&gt;WEB SUBNET&lt;/b&gt;&lt;br&gt;CIDR: &lt;b&gt;10.10.0.0/27&lt;/b&gt; &amp;nbsp; | &amp;nbsp; Mask: 255.255.255.224&lt;br&gt;Address range: 10.10.0.0 – 10.10.0.31&lt;br&gt;Azure-assignable IPs: 10.10.0.4 – 10.10.0.30&lt;br&gt;Usable capacity: &lt;b&gt;27 IPs&lt;/b&gt;&lt;br&gt;Planned Web VM: &lt;b&gt;10.10.0.4&lt;/b&gt;&lt;br&gt;Hosts: 12 today / 12 in 6 months" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B9BD5;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=14;fontSize=14;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="125" y="175" width="390" height="145" as="geometry" /></mxCell><mxCell id="db" value="&lt;b&gt;DATABASE SUBNET&lt;/b&gt;&lt;br&gt;CIDR: &lt;b&gt;10.10.0.32/28&lt;/b&gt; &amp;nbsp; | &amp;nbsp; Mask: 255.255.255.240&lt;br&gt;Address range: 10.10.0.32 – 10.10.0.47&lt;br&gt;Azure-assignable IPs: 10.10.0.36 – 10.10.0.46&lt;br&gt;Usable capacity: &lt;b&gt;11 IPs&lt;/b&gt;&lt;br&gt;Planned DB VM: &lt;b&gt;10.10.0.36&lt;/b&gt;&lt;br&gt;Hosts: 6 today / 6 in 6 months" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B9BD5;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=14;fontSize=14;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="585" y="175" width="390" height="145" as="geometry" /></mxCell><mxCell id="app" value="&lt;b&gt;APPLICATION SUBNET&lt;/b&gt;&lt;br&gt;CIDR: &lt;b&gt;10.10.0.64/26&lt;/b&gt; &amp;nbsp; | &amp;nbsp; Mask: 255.255.255.192&lt;br&gt;Address range: 10.10.0.64 – 10.10.0.127&lt;br&gt;Azure-assignable IPs: 10.10.0.68 – 10.10.0.126&lt;br&gt;Usable capacity: &lt;b&gt;59 IPs&lt;/b&gt;&lt;br&gt;Planned App VM: &lt;b&gt;10.10.0.68&lt;/b&gt;&lt;br&gt;Hosts: 20 today / 40 in 6 months" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B9BD5;strokeWidth=2;verticalAlign=middle;align=left;spacingLeft=14;fontSize=14;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="355" y="365" width="390" height="145" as="geometry" /></mxCell><mxCell id="gapnote" value="&lt;b&gt;Reserved for future expansion:&lt;/b&gt; 10.10.0.48 – 10.10.0.63 (currently unused)&lt;br&gt;&lt;b&gt;Addressing:&lt;/b&gt; Subnets are non-overlapping and aligned to valid CIDR boundaries.&lt;br&gt;&lt;b&gt;Azure note:&lt;/b&gt; Azure reserves 5 IP addresses in each IPv4 subnet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=middle;align=left;spacing=10;fontSize=12;fontColor=#5B4B00;" vertex="1" parent="1"><mxGeometry x="125" y="535" width="850" height="48" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>