        <mxCell id="vnet" value="&lt;b&gt;Azure Virtual Network (VNet)&lt;/b&gt;&lt;br&gt;Address space: 10.10.0.0/16&lt;br&gt;&lt;font style='font-size:12px;color:#53657D'&gt;Private network boundary for the three-tier deployment&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F4F9FF;strokeColor=#1261B5;strokeWidth=3;dashed=1;dashPattern=10 6;verticalAlign=top;align=center;spacingTop=14;fontSize=17;fontColor=#123A68;" vertex="1" parent="1">
