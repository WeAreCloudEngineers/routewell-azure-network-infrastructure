        <mxCell id="note" value="Unused: 10.10.0.48 – 10.10.0.63  |  Subnets are non-overlapping and CIDR-aligned  |  Azure reserves 5 IPs per subnet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D6A63B;align=center;verticalAlign=middle;fontSize=12;fontColor=#59420A;" vertex="1" parent="1">
