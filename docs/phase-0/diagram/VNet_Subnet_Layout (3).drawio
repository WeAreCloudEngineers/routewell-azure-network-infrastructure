        </mxCell>
        <mxCell id="web" value="&lt;b style='font-size:16px'&gt;WEB SUBNET&lt;/b&gt;&lt;br&gt;CIDR: &lt;b&gt;10.10.0.0/27&lt;/b&gt; | Mask: 255.255.255.224&lt;br&gt;Subnet range: &lt;b&gt;10.10.0.0 – 10.10.0.31&lt;/b&gt;&lt;br&gt;Assignable IPs: &lt;b&gt;10.10.0.4 – 10.10.0.30&lt;/b&gt;&lt;br&gt;Usable capacity: &lt;b&gt;27 IPs&lt;/b&gt;&lt;br&gt;Planned Web VM: &lt;b&gt;10.10.0.4&lt;/b&gt;&lt;br&gt;Hosts: &lt;b&gt;12 today / 12 in 6 months&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DCEEFF;strokeColor=#1683D8;strokeWidth=2;verticalAlign=top;align=left;spacingTop=10;spacingLeft=20;fontSize=14;fontColor=#10233F;" vertex="1" parent="1">
          <mxGeometry x="100" y="180" width="700" height="170" as="geometry" />
